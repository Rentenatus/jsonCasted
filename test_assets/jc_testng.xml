<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  The TestNG suite of jsonCasted (the run recipe of the repository).

  The tests resolve their asset files relative to the working directory, so run it from
  THIS directory (test_assets):

      cd test_assets
      java -cp <test classes>;<main classes>;<testng jars> org.testng.TestNG jc_testng.xml

  The asset tree lives here: assets/config, assets/legacy, assets/read. All test classes
  are listed explicitly - TestBoxNGTest2/3 carry a number suffix and no find pattern of
  NGTest classes catches them otherwise.
-->
<suite name="JsonCastedSuite">
  <test name="JsonCastedTests">
    <classes>
    <class name="de.jare.impltest.TestBoxNGTest"/>
    <class name="de.jare.impltest.TestBoxNGTest2"/>
    <class name="de.jare.impltest.TestBoxNGTest3"/>
    <class name="de.jare.jsoncasted.diff.ThreeWayDifferNGTest"/>
    <class name="de.jare.jsoncasted.diff.TreeDifferNGTest"/>
    <class name="de.jare.jsoncasted.io.convertservice.WoodListSharingNGTest"/>
    <class name="de.jare.jsoncasted.io.parserservice.MissingCommaNGTest"/>
    <class name="de.jare.jsoncasted.io.parserservice.WoodIdNotationNGTest"/>
    <class name="de.jare.jsoncasted.io.writer.JsonWoodIdLevelNGTest"/>
    <class name="de.jare.jsoncasted.io.writer.SharedListWriterNGTest"/>
    <class name="de.jare.jsoncasted.io.writer.cycle.HaraldCycleNGTest"/>
    <class name="de.jare.jsoncasted.io.writer.walker.ObjectCircleScannerWalkerNGTest"/>
    <class name="de.jare.jsoncasted.iotest.JsonObjectWriterNGTest"/>
    <class name="de.jare.jsoncasted.iotest.WoodProxyResolverBundleNGTest"/>
    <class name="de.jare.jsoncasted.iotest.WoodResolutionDescriptionFileNGTest"/>
    <class name="de.jare.jsoncasted.lang.JsonBundleNGTest"/>
    <class name="de.jare.jsoncasted.lang.JsonBundleNamespaceNGTest"/>
    <class name="de.jare.jsoncasted.lang.JsonResourceStateNGTest"/>
    <class name="de.jare.jsoncasted.model.descriptor.AnnotationValueAdoptionNGTest"/>
    <class name="de.jare.jsoncasted.model.descriptor.JsonModelDescriptorNGTest"/>
    <class name="de.jare.jsoncasted.model.descriptor.NullHardeningNGTest"/>
    <class name="de.jare.jsoncasted.model.item.AnnotationValueNGTest"/>
    <class name="de.jare.jsoncasted.parser.JsonParserNodeInputNGTest"/>
    <class name="de.jare.jsoncasted.project.BundleImportResolverNGTest"/>
    <class name="de.jare.jsoncasted.project.WoodProjectNGTest"/>
    <class name="de.jare.jsoncasted.validation.model.ReflectionValidatorNGTest"/>
    <class name="de.jare.jsonconfig.def.JsonConfigFactoryNGTest"/>
    </classes>
  </test>
</suite>
